xmvc_read#:#Lire : La participation à la réunion virtuelle est possible
xmvc_read_learning_progress#:#Consultez les progrès d'apprentissage des autres utilisateurs
xmvc_visible#:#Visible : La salle de réunion virtuelle est visible
xmvc_write#:#Modifier les paramètres
zoom_account_id#:#ID de compte Zoom
zoom_account_info#:#Vous pouvez obtenir l'ID de compte Zoom, l'ID client et le secret client sur https://developers.zoom.us/docs/internal-apps/create/. Vous devez créer une application OAuth serveur à serveur.
zoom_approval_choose#:#Inscription / authentification : Option de sélection
zoom_approval_choose_info#:#L'inscription via un lien d'accès personnalisé est rarement utilisée.
zoom_approval_default#:#Inscription/authentification : Paramètre par défaut
zoom_approval_type#:#Inscription / authentification
zoom_approval_0#:#Approbation automatique : le lien d’accès est envoyé par courriel.
zoom_approval_1#:#Approbation manuelle : les hôtes examinent et approuvent les participants avant qu’ils ne reçoivent le lien d’accès.
zoom_approval_2#:#Aucune inscription n'est requise. Aucun lien d'accès personnalisé n'est créé.
zoom_approval_3#:#Aucune inscription n'est requise, mais une authentification est nécessaire. Un compte Zoom est toujours nécessaire.
zoom_client_id#:#ID client Zoom
zoom_client_secret#:#Secret du client Zoom
zoom_err_scopes#:#Les autorisations suivantes sont manquantes pour créer une réunion :
zoom_err_scopes_webinar#:#Vous n'êtes pas autorisé à créer un webinaire. Les réunions sont possibles. Les autorisations suivantes sont manquantes :
zoom_exist_meetings#:#Les dates de cette réunion ont déjà été fixées.
zoom_exist_webinars#:#Les dates de ce webinaire ont déjà été fixées.
zoom_host_email_hidden_info#:#L'adresse électronique utilisée pour l'autorisation n'est visible que par les propriétaires de l'objet et les administrateurs.
zoom_host_email_info#:#Adresse e-mail associée à Zoom
zoom_host_email#:#Adresse e-mail de l'hôte Zoom
zoom_lobby#:#Salle d'attente pour les réunions
zoom_lobby_choose#:#Salle d'attente pour les réunions : option de sélection
zoom_lobby_choose_info#:#Activez cette option si les utilisateurs disposant de droits d'écriture doivent avoir accès à l'option « Salle d'attente » dans les paramètres. Cela détermine qui est placé en salle d'attente.
zoom_lobby_default#:#Salle d'attente pour les réunions : Paramètre par défaut
zoom_lobby_0#:#Il n'est plus nécessaire d'attendre dans la salle d'attente. Celle-ci est désactivée. Les participants peuvent entrer 15 minutes avant le début de la réunion.
zoom_lobby_1#:#Tout le monde doit se rendre dans la salle d'attente.
zoom_lobby_2#:#Les utilisateurs extérieurs à votre compte doivent se rendre dans la salle d'attente.
zoom_lobby_3#:#Les utilisateurs extérieurs à votre compte ou ceux qui n'utilisent pas les domaines approuvés doivent se rendre dans la salle d'attente.
zoom_lobby_4#:#Les personnes qui ne font pas partie du cours ou du groupe doivent se rendre en salle d'attente.
zoom_rec_only_for_webinars_default#:#Enregistrement uniquement lors des webinaires.
zoom_rec_only_for_webinars_default_info#:#Si cette option est activée, l'enregistrement automatique des réunions est désactivé. Il est généralement recommandé d'activer cette option. Elle n'est effective que si les enregistrements sont autorisés.