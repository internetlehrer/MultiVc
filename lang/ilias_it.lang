zoom_approval_choose_info#:#La registrazione con un link di accesso personalizzato non viene spesso utilizzata.
zoom_approval_default#:#Registrazione/autenticazione: impostazione predefinita
zoom_approval_type#:#Registrazione/autenticazione
zoom_approval_0#:#Approvazione automatica: il link di accesso viene inviato tramite e-mail.
zoom_approval_1#:#Approvazione manuale: gli organizzatori esaminano e approvano i partecipanti prima che ricevano il link di accesso.
zoom_approval_2#:#Non è richiesta alcuna registrazione. Non verrà creato un link di accesso personalizzato.
zoom_approval_3#:#Non è necessaria la registrazione, ma l'autenticazione è richiesta. È sempre necessario un account Zoom.
zoom_client_id#:#ID client Zoom
zoom_client_secret#:#Segreto del client Zoom
zoom_err_scopes#:#Per creare una riunione non sono necessarie le seguenti autorizzazioni:
zoom_err_scopes_webinar#:#Non si dispone dell'autorizzazione per creare un webinar. È possibile organizzare riunioni. Mancano le seguenti autorizzazioni:
zoom_exist_meetings#:#Le date per questo incontro sono già state fissate.
zoom_exist_webinars#:#Le date per questo webinar sono già state fissate.
zoom_host_email_hidden_info#:#L'indirizzo email utilizzato per l'autorizzazione è visibile solo ai proprietari dell'oggetto e agli amministratori.
zoom_host_email_info#:#Indirizzo email associato a Zoom
zoom_host_email#:#Indirizzo e-mail dell'organizzatore della riunione Zoom
zoom_lobby#:#Sala d'attesa per le riunioni
zoom_lobby_choose#:#Sala d'attesa per riunioni: opzione di selezione
zoom_lobby_choose_info#:#Abilita questa opzione se desideri che gli utenti con permessi di scrittura abbiano accesso alla "Sala d'attesa" nelle impostazioni. Questa opzione controlla chi viene inserito nella sala d'attesa.
zoom_lobby_default#:#Sala d'attesa per le riunioni: impostazione predefinita
zoom_lobby_0#:#Nessuno deve attendere nella sala d'attesa. La sala d'attesa è disattivata. I partecipanti possono accedere 15 minuti prima dell'inizio della riunione.
zoom_lobby_1#:#Tutti devono recarsi nella sala d'attesa.
zoom_lobby_2#:#Gli utenti esterni al tuo account devono accedere alla sala d'attesa.
zoom_lobby_3#:#Gli utenti esterni al tuo account o quelli non appartenenti ai domini approvati devono accedere alla sala d'attesa.
zoom_lobby_4#:#Gli utenti che non sono iscritti al corso o al gruppo devono recarsi nella sala d'attesa.
zoom_rec_only_for_webinars_default#:#Registrazione disponibile solo per i webinar.
zoom_rec_only_for_webinars_default_info#:#Se questa opzione è abilitata, la registrazione automatica non è disponibile durante le riunioni. Questa opzione dovrebbe essere abilitata nella maggior parte dei casi. Ha effetto solo se le registrazioni sono generalmente consentite.