zoom_approval_choose_info#:#Registratie met een gepersonaliseerde toegangslink wordt vaak niet gebruikt.
zoom_approval_default#:#Registratie/authenticatie: Standaardinstelling
zoom_approval_type#:#Registratie / authenticatie
zoom_approval_0#:#Automatische goedkeuring: De toegangslink wordt per e-mail verzonden.
zoom_approval_1#:#Handmatige goedkeuring: De hosts beoordelen en keuren de deelnemers goed voordat ze de toegangslink ontvangen.
zoom_approval_2#:#Registratie is niet nodig. Er wordt geen persoonlijke toegangslink aangemaakt.
zoom_approval_3#:#Geen registratie nodig, maar authenticatie is vereist. Een Zoom-account is altijd noodzakelijk.
zoom_client_id#:#Zoom-client-ID
zoom_client_secret#:#Zoom-clientgeheim
zoom_err_scopes#:#De volgende machtigingen ontbreken om een ​​vergadering te kunnen aanmaken:
zoom_err_scopes_webinar#:#Je hebt geen toestemming om een ​​webinar te maken. Vergaderingen zijn wel mogelijk. De volgende machtigingen ontbreken:
zoom_exist_meetings#:#De datum voor deze bijeenkomst is al vastgesteld.
zoom_exist_webinars#:#De data voor dit webinar zijn al vastgesteld.
zoom_host_email_hidden_info#:#Het e-mailadres dat voor autorisatie wordt gebruikt, is alleen zichtbaar voor de eigenaren van het object en beheerders.
zoom_host_email_info#:#E-mailadres gekoppeld aan Zoom
zoom_host_email#:#E-mailadres van de Zoom-host
zoom_lobby#:#Wachtruimte voor vergaderingen
zoom_lobby_choose#:#Wachtruimte voor vergaderingen: selectieoptie
zoom_lobby_choose_info#:#Schakel deze optie in als gebruikers met schrijfrechten de optie 'Wachtkamer' in de instellingen moeten kunnen gebruiken. Hiermee bepaalt u wie in de wachtkamer wordt geplaatst.
zoom_lobby_default#:#Wachtkamer voor vergaderingen: Standaardinstelling
zoom_lobby_0#:#Niemand hoeft in de wachtkamer te wachten. De wachtkamer is gedeactiveerd. Deelnemers kunnen 15 minuten voor aanvang van de vergadering deelnemen.
zoom_lobby_1#:#Iedereen moet naar de wachtkamer.
zoom_lobby_2#:#Gebruikers die niet tot uw account behoren, moeten de wachtkamer betreden.
zoom_lobby_3#:#Gebruikers buiten uw account of gebruikers die zich niet op de goedgekeurde domeinen bevinden, moeten in de wachtkamer plaatsnemen.
zoom_lobby_4#:#Gebruikers die niet aan de cursus of groep deelnemen, moeten naar de wachtkamer gaan.
zoom_rec_only_for_webinars_default#:#Alleen opnames bij webinars.
zoom_rec_only_for_webinars_default_info#:#Als deze optie is ingeschakeld, is automatisch opnemen niet mogelijk tijdens vergaderingen. Deze optie moet in de meeste gevallen ingeschakeld zijn. De wijziging treedt alleen in werking als opnemen in het algemeen is toegestaan.