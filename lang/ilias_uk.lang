zoom_account_info#:#Ви можете отримати ідентифікатор облікового запису Zoom, ідентифікатор клієнта та секретний ключ клієнта за адресою https://developers.zoom.us/docs/internal-apps/create/. Вам потрібно створити програму OAuth між серверами.
zoom_approval_choose#:#Реєстрація / автентифікація: варіант вибору
zoom_approval_choose_info#:#Реєстрація за персоналізованим посиланням доступу часто не використовується.
zoom_approval_default#:#Реєстрація / автентифікація: налаштування за замовчуванням
zoom_approval_type#:#Реєстрація / автентифікація
zoom_approval_0#:#Автоматичне схвалення: посилання для доступу надсилається електронною поштою.
zoom_approval_1#:#Ручне затвердження: організатори перевіряють та затверджують учасників, перш ніж вони отримають посилання для доступу.
zoom_approval_2#:#Реєстрація не потрібна. Персоналізоване посилання для доступу не створюється.
zoom_approval_3#:#Реєстрація не потрібна, але потрібна автентифікація. Завжди потрібен обліковий запис Zoom.
zoom_client_id#:#Ідентифікатор клієнта Zoom
zoom_client_secret#:#Секрет клієнта Zoom
zoom_err_scopes#:#Для створення зустрічі бракує таких дозволів:
zoom_err_scopes_webinar#:#У вас немає дозволу на створення вебінару. Зустрічі можливі. Бракує таких дозволів:
zoom_exist_meetings#:#Дати цієї зустрічі вже визначені.
zoom_exist_webinars#:#Дати для цього вебінару вже визначені.
zoom_host_email_hidden_info#:#Адреса електронної пошти, яка використовується для авторизації, видима лише власникам об'єкта та адміністраторам.
zoom_host_email_info#:#Адреса електронної пошти, пов'язана з Zoom
zoom_host_email#:#Адреса електронної пошти хоста Zoom
zoom_lobby#:#Зал очікування для зустрічей
zoom_lobby_choose#:#Зал очікування для зустрічей: варіант вибору
zoom_lobby_choose_info#:#Увімкніть цю опцію, якщо користувачі з правами на запис повинні мати опцію «Зал очікування» в налаштуваннях. Це контролює, хто буде розміщений у залі очікування.
zoom_lobby_default#:#Зал очікування для зустрічей: налаштування за замовчуванням
zoom_lobby_0#:#Нікому не потрібно чекати в залі очікування. Зала очікування деактивована. Учасники можуть зайти за 15 хвилин до початку зустрічі.
zoom_lobby_1#:#Усім потрібно пройти до зали очікування.
zoom_lobby_2#:#Користувачі за межами вашого облікового запису повинні увійти до кімнати очікування.
zoom_lobby_3#:#Користувачі за межами вашого облікового запису або ті, хто не входить до схвалених доменів, повинні увійти до кімнати очікування.
zoom_lobby_4#:#Користувачі, які не перебувають на курсі чи в групі, повинні пройти до кімнати очікування.
zoom_rec_only_for_webinars_default#:#Запис лише на вебінарах.
zoom_rec_only_for_webinars_default_info#:#Якщо цю опцію ввімкнено, автоматичний запис на зустрічах недоступний. Цю опцію слід увімкнути в більшості випадків. Вона діє, лише якщо записи загалом дозволені.